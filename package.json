{
  "name": "prepinminutes-backend",
  "version": "1.0.0",
  "private": true,
  "description": "PrepInMinutes Edge Backend API Services (Cloudflare Workers, Neon PostgreSQL + pgvector, Upstash Redis, R2, Gemini AI, Deepgram, Cartesia)",
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "test:db": "tsx scripts/test-db-connection.ts",
    "test:clients": "tsx scripts/test-phase2-clients.ts",
    "test:domain": "tsx scripts/test-phase3-domain.ts",
    "test:security": "tsx scripts/test-phase4-security.ts",
    "test:onboarding": "tsx scripts/test-phase5-onboarding.ts",
    "test:eval": "tsx scripts/test-phase6-session-eval.ts",
    "test:sso": "tsx scripts/test-sso-login.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1146.0",
    "@aws-sdk/s3-request-presigner": "^3.1146.0",
    "@google/genai": "^2.27.0",
    "@neondatabase/serverless": "^1.2.0",
    "@prisma/adapter-neon": "^7.10.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@upstash/ratelimit": "^2.2.0",
    "@upstash/redis": "^1.39.0",
    "dotenv": "^16.4.7",
    "pdf-parse": "^2.4.5",
    "pg": "^8.23.1",
    "ws": "^8.22.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "@types/pdf-parse": "^1.1.5",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.2",
    "prisma": "^7.10.0",
    "tsx": "^4.23.15",
    "typescript": "^5.8.2",
    "wrangler": "^4.86.0"
  },
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  }
}
