# ==============================================================================
# PrepInMinutes Backend Services — Environment Configuration
# ==============================================================================

# Authentication & Single Sign-On (Default: Google SSO enabled, Clerk disabled)
AUTH_PROVIDER="google"                        # "google" | "clerk" | "both"
GOOGLE_SSO_FLOW="both"                        # "redirect" | "id_token" | "both"
GOOGLE_CLIENT_ID="your_google_oauth_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_oauth_client_secret"
GOOGLE_REDIRECT_URI="http://localhost:8787/api/auth/google/callback"
FRONTEND_URL="http://localhost:3000"
JWT_SECRET="replace_with_a_strong_32_byte_hmac_sha256_secret"

# Optional Clerk Authentication (Disabled when AUTH_PROVIDER="google")
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Neon Serverless PostgreSQL + pgvector
DATABASE_URL="postgresql://[user]:[password]@[endpoint]-pooler.us-east-2.aws.neon.tech/[database]?sslmode=require"
DIRECT_URL="postgresql://[user]:[password]@[endpoint].us-east-2.aws.neon.tech/[database]?sslmode=require"

# Upstash Redis (Rate Limiting & 24h Idempotency)
UPSTASH_REDIS_REST_URL="https://your-database.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your_upstash_token"

# Cloudflare R2 Object Storage
R2_ACCOUNT_ID="your_cloudflare_account_id"
R2_ENDPOINT="https://your_account_id.r2.cloudflarestorage.com"
R2_ACCESS_KEY_ID="your_r2_access_key_id"
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
R2_BUCKET_NAME="prepinminutes-assets"

# Google Gemini AI (Reasoning & 1536-dim Embeddings)
GEMINI_API_KEY="your_gemini_api_key"
GOOGLE_AI_PROJECT_ID="projects/your_project_id"
GOOGLE_AI_PROJECT_NUMBER="your_project_number"

# Real-Time Voice Gateway (Deepgram STT & Cartesia TTS)
DEEPGRAM_PROJECT_ID="your_deepgram_project_id"
DEEPGRAM_API_KEY="your_deepgram_api_key"
CARTESIA_API_KEY="sk_car_xxxxxxxxxxxxxxxxxxxx"

# Hermes Autonomous Runner — Telegram Notifications
TELEGRAM_BOT_TOKEN="your_telegram_bot_token"
TELEGRAM_CHAT_ID="your_telegram_chat_id"

# Transactional Email Service (Resend - Free 3,000 emails/mo, 100/day at https://resend.com)
# When omitted, emails are simulated locally in backend terminal logs & on-screen dev banner
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxx"
EMAIL_FROM="PrepInMinutes <onboarding@resend.dev>"


